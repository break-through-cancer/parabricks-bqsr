nextflow_process {
    name "Test QUANTIZE_QUALS"
    script "modules/local/quantize_quals.nf"
    process "QUANTIZE_QUALS"

    test("default params: BAM output is quantized nearest-in-probability-space and indexed") {
        when {
            process {
                """
                input[0] = [ [ sample: 'TEST_SAMPLE', suffix: 'recal' ], file("\${projectDir}/tests/fixtures/modules/sample.bam") ]
                input[1] = [
                    file("\${projectDir}/tests/fixtures/modules/reference.fasta"),
                    file("\${projectDir}/tests/fixtures/modules/reference.fasta.fai")
                ]
                input[2] = 'bam'
                """
            }
        }
        then {
            assert process.success
            def (meta, bam_out, idx) = process.out[0][0]
            assert meta == [ sample: 'TEST_SAMPLE', suffix: 'recal' ]
            assert file(bam_out).name == 'TEST_SAMPLE.recal.bam'
            assert file(idx).name == 'TEST_SAMPLE.recal.bam.bai'
            assert bam(bam_out).getSamLines()*.trim() ==
                file("${projectDir}/tools/quantize_quals/tests/fixtures/expected_nearest.body.sam").readLines()
            assert bam(bam_out).getHeader().any { it.startsWith("@PG\tID:quantize_quals") }
        }
    }

    test("round_down_quantized with CRAM output: reads CRAM input, writes indexed CRAM") {
        when {
            params {
                round_down_quantized = true
            }
            process {
                """
                input[0] = [ [ sample: 'TEST_SAMPLE', suffix: 'recal' ], file("\${projectDir}/tests/fixtures/modules/sample.cram") ]
                input[1] = [
                    file("\${projectDir}/tests/fixtures/modules/reference.fasta"),
                    file("\${projectDir}/tests/fixtures/modules/reference.fasta.fai")
                ]
                input[2] = 'cram'
                """
            }
        }
        then {
            assert process.success
            def (meta, cram_out, idx) = process.out[0][0]
            assert file(cram_out).name == 'TEST_SAMPLE.recal.cram'
            assert file(idx).name == 'TEST_SAMPLE.recal.cram.crai'
            def core = { List lines -> lines.collect { it.trim().tokenize('\t').take(11).join('\t') }.sort() }
            assert core(cram(cram_out, "${projectDir}/tests/fixtures/modules/reference.fasta").getSamLines()) ==
                core(file("${projectDir}/tools/quantize_quals/tests/fixtures/expected_round_down.body.sam").readLines())
        }
    }

    test("an input named <sample>.recal.bam does not collide with the output name") {
        when {
            process {
                """
                input[0] = [ [ sample: 'collide', suffix: 'recal' ], file("\${projectDir}/tests/fixtures/modules/collide.recal.bam") ]
                input[1] = [
                    file("\${projectDir}/tests/fixtures/modules/reference.fasta"),
                    file("\${projectDir}/tests/fixtures/modules/reference.fasta.fai")
                ]
                input[2] = 'bam'
                """
            }
        }
        then {
            assert process.success
            assert file(process.out[0][0][1]).name == 'collide.recal.bam'
        }
    }

    test("a preserve threshold not below the smallest bin fails the task with the tool's message") {
        when {
            params {
                preserve_qscores_less_than = 10
            }
            process {
                """
                input[0] = [ [ sample: 'TEST_SAMPLE', suffix: 'recal' ], file("\${projectDir}/tests/fixtures/modules/sample.bam") ]
                input[1] = [
                    file("\${projectDir}/tests/fixtures/modules/reference.fasta"),
                    file("\${projectDir}/tests/fixtures/modules/reference.fasta.fai")
                ]
                input[2] = 'bam'
                """
            }
        }
        then {
            assert process.failed
            assert (process.stdout + process.stderr).join('\n').contains('strictly below')
        }
    }

    test("md suffix names the output .md and writes a MultiQC summary row") {
        when { process { """
            input[0] = [[sample: 'TEST_SAMPLE', suffix: 'md'], file("\${projectDir}/tests/fixtures/modules/sample.bam")]
            input[1] = [file("\${projectDir}/tests/fixtures/modules/reference.fasta"), file("\${projectDir}/tests/fixtures/modules/reference.fasta.fai")]
            input[2] = 'bam'
        """ } }
        then {
            assert process.success
            assert file(process.out.alignment[0][1]).name == 'TEST_SAMPLE.md.bam'
            def tsv = file(process.out.mqc[0]).text
            assert tsv.contains('TEST_SAMPLE\t11\t365\t299\t81.9')
        }
    }
}

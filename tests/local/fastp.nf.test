nextflow_process {
    name "Test FASTP"
    script "modules/local/fastp.nf"
    process "FASTP"

    test("report-only paired lane emits counts covering both mates and passes reads through") {
        when { process { """
            input[0] = [[id: 'S1_1', sample: 'S1', single_end: false],
                        [file("\${projectDir}/tests/fixtures/fastq/S1_L1_R1.fastq.gz"), file("\${projectDir}/tests/fixtures/fastq/S1_L1_R2.fastq.gz")]]
            input[1] = false
        """ } }
        then {
            assert process.success
            def json = new groovy.json.JsonSlurper().parse(file(process.out.json[0][1]))
            assert json.summary.before_filtering.total_reads == 80
            assert process.out.reads[0][1].collect { file(it).name } == ['S1_L1_R1.fastq.gz', 'S1_L1_R2.fastq.gz']
        }
    }
    test("trimming single-end lane writes a trimmed FASTQ") {
        when { process { """
            input[0] = [[id: 'S2_1', sample: 'S2', single_end: true], [file("\${projectDir}/tests/fixtures/fastq/S2_L1.fastq.gz")]]
            input[1] = true
        """ } }
        then {
            assert process.success
            def trimmed = process.out.reads[0][1]
            assert (trimmed instanceof List ? trimmed : [trimmed]).collect { file(it).name } == ['S2_1_1.trimmed.fastq.gz']
            assert new groovy.json.JsonSlurper().parse(file(process.out.json[0][1])).summary.after_filtering.total_reads == 25
        }
    }
}
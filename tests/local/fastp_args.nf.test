nextflow_function {
    name "Test fastpArgs"
    script "modules/local/fastp.nf"
    function "fastpArgs"

    test("report-only paired: no output FASTQs, every filter and trimmer off") {
        when { function { """
            input[0] = [id: 'S1_1', single_end: false]
            input[1] = ['r1.fastq.gz', 'r2.fastq.gz']
            input[2] = [trim: false, threads: 4]
        """ } }
        then {
            def a = function.result
            assert a.contains('-i r1.fastq.gz -I r2.fastq.gz')
            assert !a.contains(' -o ') && !a.contains(' -O ')
            ['--disable_quality_filtering', '--disable_adapter_trimming', '--disable_trim_poly_g', '--disable_length_filtering'].each { assert a.contains(it) }
            assert a.contains('-j S1_1.fastp.json -h S1_1.fastp.html')
        }
    }
    test("trimming single-end: one output, quality filter still off, poly-G off unless trim_nextseq") {
        when { function { """
            input[0] = [id: 'S2_1', single_end: true]
            input[1] = 's.fastq.gz'
            input[2] = [trim: true, clip_r1: 3, clip_r2: 5, three_prime_clip_r1: 2, three_prime_clip_r2: 0,
                        trim_nextseq: false, length_required: 15, threads: 2]
        """ } }
        then {
            def a = function.result
            assert a.contains('-i s.fastq.gz -o S2_1_1.trimmed.fastq.gz')
            assert !a.contains(' -I ') && !a.contains('--trim_front2') && !a.contains('--detect_adapter_for_pe')
            assert a.contains('--disable_quality_filtering') && a.contains('--disable_trim_poly_g')
            assert a.contains('--trim_front1 3') && a.contains('--trim_tail1 2') && a.contains('--length_required 15')
        }
    }
    test("trimming paired with poly-G") {
        when { function { """
            input[0] = [id: 'S1_1', single_end: false]
            input[1] = ['r1.fastq.gz', 'r2.fastq.gz']
            input[2] = [trim: true, clip_r1: 0, clip_r2: 0, three_prime_clip_r1: 0, three_prime_clip_r2: 0,
                        trim_nextseq: true, length_required: 20, threads: 4]
        """ } }
        then {
            def a = function.result
            assert a.contains('-o S1_1_1.trimmed.fastq.gz -O S1_1_2.trimmed.fastq.gz')
            assert a.contains('--trim_poly_g') && !a.contains('--disable_trim_poly_g') && a.contains('--detect_adapter_for_pe')
        }
    }
}

nextflow_process {
    name "Test SAMTOOLS_FINALIZE"
    script "modules/local/samtools_finalize.nf"
    process "SAMTOOLS_FINALIZE"

    test("bam: indexes the BAM under <sample>.recal.bam without re-encoding it") {
        when {
            process {
                """
                input[0] = [ [ sample: 'TEST_SAMPLE', suffix: 'recal' ], file("\${projectDir}/tests/fixtures/modules/sample.bam") ]
                input[1] = [
                    file("\${projectDir}/tests/fixtures/modules/reference.fasta"),
                    file("\${projectDir}/tests/fixtures/modules/reference.fasta.fai")
                ]
                input[2] = 'bam'
                """
            }
        }
        then {
            assert process.success
            def (meta, bam_out, idx) = process.out[0][0]
            assert file(bam_out).name == 'TEST_SAMPLE.recal.bam'
            assert file(idx).name == 'TEST_SAMPLE.recal.bam.bai'
            assert file(bam_out).bytes == file("${projectDir}/tests/fixtures/modules/sample.bam").bytes
        }
    }

    test("cram: converts to an indexed CRAM") {
        when {
            process {
                """
                input[0] = [ [ sample: 'TEST_SAMPLE', suffix: 'recal' ], file("\${projectDir}/tests/fixtures/modules/sample.bam") ]
                input[1] = [
                    file("\${projectDir}/tests/fixtures/modules/reference.fasta"),
                    file("\${projectDir}/tests/fixtures/modules/reference.fasta.fai")
                ]
                input[2] = 'cram'
                """
            }
        }
        then {
            assert process.success
            def (meta, cram_out, idx) = process.out[0][0]
            assert file(cram_out).name == 'TEST_SAMPLE.recal.cram'
            assert file(idx).name == 'TEST_SAMPLE.recal.cram.crai'
            def ref = "${projectDir}/tests/fixtures/modules/reference.fasta"
            def core = { List lines -> lines.collect { it.trim().tokenize('\t').take(11).join('\t') }.sort() }
            assert cram(cram_out, ref).getFileType() == 'CRAM'
            assert core(cram(cram_out, ref).getSamLines()) ==
                core(bam("${projectDir}/tests/fixtures/modules/sample.bam").getSamLines())
        }
    }

    test("md CRAM 3.1 input with default CRAM 3.0 output is re-encoded, not overwritten") {
        when { process { """
            input[0] = [[sample: 'TEST_SAMPLE', suffix: 'md'], file("\${projectDir}/tests/fixtures/modules/sample.cram")]
            input[1] = [file("\${projectDir}/tests/fixtures/modules/reference.fasta"), file("\${projectDir}/tests/fixtures/modules/reference.fasta.fai")]
            input[2] = 'cram'
        """ } }
        then {
            assert process.success
            def (meta, out, idx) = process.out.alignment[0]
            assert file(out).name == 'TEST_SAMPLE.md.cram' && file(idx).name == 'TEST_SAMPLE.md.cram.crai'
            assert cram(out, "${projectDir}/tests/fixtures/modules/reference.fasta").getSamLines().size() == 11
            assert file(out).bytes[5] == 0
        }
    }
    test("md CRAM input with BAM output converts") {
        when { process { """
            input[0] = [[sample: 'TEST_SAMPLE', suffix: 'md'], file("\${projectDir}/tests/fixtures/modules/sample.cram")]
            input[1] = [file("\${projectDir}/tests/fixtures/modules/reference.fasta"), file("\${projectDir}/tests/fixtures/modules/reference.fasta.fai")]
            input[2] = 'bam'
        """ } }
        then {
            assert process.success
            assert file(process.out.alignment[0][1]).name == 'TEST_SAMPLE.md.bam'
            assert bam(process.out.alignment[0][1].toString()).getFileType() == 'BAM'
        }
    }

    test("md CRAM 3.1 input with cram_version 3.1 is linked unchanged") {
        when {
            params { cram_version = '3.1' }
            process { """
                input[0] = [[sample: 'TEST_SAMPLE', suffix: 'md'], file("\${projectDir}/tests/fixtures/modules/sample.cram")]
            input[1] = [file("\${projectDir}/tests/fixtures/modules/reference.fasta"), file("\${projectDir}/tests/fixtures/modules/reference.fasta.fai")]
                input[2] = 'cram'
            """ }
        }
        then {
            assert process.success
            def out = process.out.alignment[0][1]
            assert file(out).bytes == file("${projectDir}/tests/fixtures/modules/sample.cram").bytes
        }
    }
}

nextflow.enable.dsl = 2

params.input  = null
params.outdir = './results'

params.ref_fasta     = 's3://broad-references/hg38/v0/Homo_sapiens_assembly38.fasta'
params.ref_fasta_fai = 's3://broad-references/hg38/v0/Homo_sapiens_assembly38.fasta.fai'

params.output_fmt = 'cram'

params.quantize_quals_enabled       = true
params.quantize_quals_container     = 'quantize-quals:0.1.0'
params.static_quantized_quals       = '10,20,30'
params.preserve_qscores_less_than   = 6
params.round_down_quantized         = false

includeConfig 'conf/modules.config'

docker {
    enabled = true
}
